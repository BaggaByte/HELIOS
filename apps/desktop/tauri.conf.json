{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HELIOS",
  "version": "0.1.0",
  "identifier": "com.baggabyte.helios",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "HELIOS Offensive Copilot",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "plugins": {
    "shell": {
      "all": false,
      "execute": [],
      "open": true
    }
  },
  "bundle": {
    "externalBin": [
      "bin/helios_backend"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
