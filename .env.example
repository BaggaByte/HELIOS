APP_NAME=HELIOS
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./helios.db
DATABASE_POOL_SIZE=5
CHROMA_PERSIST_DIR=./data/chroma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost,https://tauri.localhost
EMBEDDING_MODEL=all-MiniLM-L6-v2
ENCRYPTION_KEY_PATH=./data/keys
MAX_UPLOAD_SIZE=524288000
OV_DEVICE=AUTO
OV_MAX_CONTEXT=4096
OV_MODEL_PATH=../models/phi4_mini_int4_ov
OV_TEMPERATURE=0.1
OV_TOP_P=0.9
SECRET_KEY=change-me-in-production
UPLOAD_DIR=./data/uploads

# ── Background Tasks (optional — falls back to synchronous if Redis unavailable) ──
# Install Redis and run: uv run celery -A helios.infrastructure.celery_app.celery_app worker -Q helios
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
